# Variáveis do aplicativo mobile (copie para .env e ajuste).
# Nenhum valor aqui é secreto: o app nunca recebe credenciais administrativas.

# URL pública da API (sem barra no final). Se omitida, usa o valor padrão de src/config.ts.
EXPO_PUBLIC_API_URL=https://seu-projeto.vercel.app

# Id do projeto EAS (necessário para o token de push no iOS). Gerado por `npx eas-cli init`.
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Identificadores nativos (devem bater com os apps cadastrados no Firebase).
ANDROID_PACKAGE=br.com.fiap.chatfirebase
IOS_BUNDLE_ID=br.com.fiap.chatfirebase
