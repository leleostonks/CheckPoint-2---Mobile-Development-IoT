rules_version = '2';

// Regras do Cloud Firestore.
// Validações que dependem do Firestore E do Realtime Database são feitas pela API (Admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPhotoUrl(url) {
      return url is string && url.size() <= 1024 && (url == '' || url.matches('^https://.+'));
    }

    // ---------- Perfil completo: somente o próprio usuário lê pelo app ----------
    // Perfis de terceiros são entregues pela API, que confirma conversa/grupo em comum.
    match /users/{uid} {
      function validUser(data) {
        return data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.email is string && data.email.lower() == request.auth.token.email.lower()
          && data.phoneNumber is string && data.phoneNumber.size() <= 20
          && data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validPhotoUrl(data.photoUrl)
          && data.createdAt is int;
      }

      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validUser(request.resource.data);
      allow update: if isSelf(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Tokens de push: nunca públicos, apenas o dono lê e grava.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'tokenType', 'platform', 'enabled', 'updatedAt', 'disabledReason'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && request.resource.data.tokenType in ['fcm', 'expo']
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;
      }
    }

    // ---------- Nome e foto: necessários para listar e buscar usuários ----------
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && validPhotoUrl(request.resource.data.photoUrl);
      allow delete: if false;
    }

    // ---------- Conversas individuais: id = "direct_" + uids ordenados ----------
    match /directConversations/{conversationId} {
      // `get` pelo id funciona mesmo antes de a conversa existir (o uid faz parte do id).
      allow get: if signedIn() && request.auth.uid in conversationId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        // exatamente dois usuários diferentes, em ordem: impede conversa consigo mesmo e duplicidade
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == 'direct_' + request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[1]))
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // ---------- Grupos ----------
    match /groups/{groupId} {
      function validGroup(data) {
        return data.keys().hasOnly([
            'name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
            'notificationPolicy', 'updatedBy', 'createdAt', 'updatedAt'
          ])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 60
          && validPhotoUrl(data.photoUrl)
          && data.memberIds is list
          && data.memberIds.size() >= 2
          && data.memberIds.toSet().size() == data.memberIds.size()
          && data.ownerId in data.memberIds
          && data.memberLimit is int
          && data.memberLimit >= 2 && data.memberLimit <= 100
          // LIMITE DE INTEGRANTES: avaliado no servidor, sobre o documento final de cada escrita.
          // Escritas concorrentes são serializadas pelo Firestore; nenhuma pode ultrapassar o limite.
          && data.memberIds.size() <= data.memberLimit
          && data.notificationPolicy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
          && data.updatedBy == request.auth.uid
          && data.createdAt is int
          && data.updatedAt is int;
      }

      // Somente integrantes ativos leem o grupo.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data);

      // Somente o proprietário gerencia integrantes, limite e política.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validGroup(request.resource.data);

      allow delete: if false;
    }

    // Controle de idempotência dos pushes: acesso exclusivo da API (Admin SDK ignora as regras).
    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }
  }
}
